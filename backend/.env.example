# --- Uygulama ---
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=debug

# --- Veritabanı & Cache ---
DATABASE_URL=postgresql://devacademy:devacademy@localhost:5432/devacademy?schema=public
REDIS_URL=redis://localhost:6379

# --- Kimlik doğrulama ---
JWT_ACCESS_SECRET=degistir-bunu-en-az-32-karakter-uzunlugunda-olsun
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Web refresh çerezi SameSite (lax|strict|none). Web ve API farklı alan adlarındaysa none (https zorunlu)
REFRESH_COOKIE_SAMESITE=lax
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# --- Depolama (S3 uyumlu: MinIO / AWS S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=devacademy-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/devacademy-media

# --- Bildirimler ---
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
SMTP_URL=
MAIL_FROM=DevAcademy <no-reply@devacademy.local>
# E-postadaki şifre sıfırlama / doğrulama bağlantılarının web adresi
WEB_URL=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# --- İzleme ---
# Prometheus GET /metrics (prefix dışında, JWT ve rate limit yok). false ise uç nokta 404 döner
METRICS_ENABLED=true
# Boş bırakılırsa Sentry hiç yüklenmez; verilirse yalnızca 5xx hatalar raporlanır
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- İçerik ---
CONTENT_DIR=../content
SEED_ADMIN_EMAIL=admin@devacademy.local
SEED_ADMIN_PASSWORD=Admin123!
