# Docker Compose ayarları — bu dosyayı .env olarak kopyalayın: cp .env.example .env
# Açılacak profiller: app = api + web; media = MinIO (yalnızca admin medya yükleme için)
COMPOSE_PROFILES=app

# Sunucuya DIŞARIDAN erişilen adres (telefon / başka bilgisayar). Yerel kullanımda localhost.
# Örn. ev sunucusunun LAN IP'si: 192.168.1.50 — web, API ve CORS bu adrese göre kurulur.
PUBLIC_HOST=localhost

# En az 32 karakter; üretimde mutlaka değiştirin
JWT_ACCESS_SECRET=degistir-bunu-en-az-32-karakter-uzunlugunda-olsun
SEED_ADMIN_PASSWORD=Admin123!

# İsteğe bağlı hata izleme: Sentry DSN verilirse API 5xx hataları raporlar (boşsa kapalı)
SENTRY_DSN=
