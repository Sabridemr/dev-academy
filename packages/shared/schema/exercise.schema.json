{
  "$ref": "#/definitions/exercise",
  "definitions": {
    "exercise": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "tr": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "tr"
              ],
              "additionalProperties": false
            }
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "python"
          ],
          "default": "python"
        },
        "prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "tr": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "tr"
              ],
              "additionalProperties": false
            }
          ]
        },
        "starter": {
          "type": "string"
        },
        "solution": {
          "type": "string"
        },
        "tests": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "tr": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "tr"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 5,
          "default": []
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 500,
          "maximum": 30000,
          "default": 5000
        }
      },
      "required": [
        "id",
        "title",
        "prompt",
        "starter",
        "solution",
        "tests"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
