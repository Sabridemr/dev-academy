{
  "$ref": "#/definitions/learning-path",
  "definitions": {
    "learning-path": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "tr": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "tr"
              ],
              "additionalProperties": false
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "tr": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                }
              },
              "required": [
                "tr"
              ],
              "additionalProperties": false
            }
          ]
        },
        "icon": {
          "type": "string",
          "default": "route"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "description",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
