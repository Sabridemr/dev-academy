{
  "name": "devacademy",
  "private": true,
  "version": "0.1.0",
  "description": "DevAcademy — yazılım mimarisi ve yapay zekâ konularını animasyonlu, interaktif derslerle öğreten web + mobil platform (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "content:validate": "pnpm --filter @devacademy/shared run content:validate",
    "content:traces": "pnpm --filter @devacademy/shared run content:traces",
    "db:migrate": "pnpm --filter @devacademy/backend run prisma:migrate",
    "db:seed": "pnpm --filter @devacademy/backend run prisma:seed",
    "content:export": "pnpm --filter @devacademy/backend run content:export",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.28",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-test-renderer": "19.2.3",
      "@types/react": "~19.2.4"
    }
  }
}
