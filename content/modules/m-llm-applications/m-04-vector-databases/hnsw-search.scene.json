    },
    {
      "id": "e-a0-b0",
      "from": "a0",
      "to": "b0",
      "kind": "generic"
    },
    {
      "id": "e-b0-c0",
      "from": "b0",
      "to": "c0",
      "kind": "generic"
    },
    {
      "id": "e-c0-d0",
      "from": "c0",
      "to": "d0",
      "kind": "generic"
    },
    {
      "id": "e-b0-res",
      "from": "b0",
      "to": "res",
      "kind": "response",
      "curvature": -0.35
    }
  ],
  "steps": [
    {
      "id": "embed-doc",
      "title": {
        "tr": "Parça gömülür",
        "en": "The chunk is embedded"
      },
      "narration": {
        "tr": "Dizine eklenecek yeni metin parçası gömme modelinden geçer ve yüzlerce boyutlu, normalize edilmiş bir vektöre dönüşür. Belgeler ve sorgular aynı modelle, aynı sürümle gömülmelidir.",
        "en": "The new text chunk to be indexed passes through the embedding model and becomes a normalised vector with hundreds of dimensions. Documents and queries must be embedded with the same model and version."
      },
      "durationMs": 3000,
      "inherit": false,
      "highlight": {
        "nodes": [
          "doc",
          "emb"
        ],
        "edges": [
          "e-doc-emb"
        ]
      },
      "nodeStates": {
        "doc": {
          "status": "active"
        },
        "emb": {
          "status": "busy",
          "badge": "[0.12, -0.4, …]"
        }
      },
      "edgeStates": {
        "e-emb-a2": {
          "status": "muted"
        },
        "e-b0-res": {
          "status": "muted"
        }
      },
      "packets": [
        {
          "edge": "e-doc-emb",
          "shape": "envelope",
          "label": {
            "tr": "iade politikası §3",
            "en": "return policy §3"
          },
          "durationMs": 1200
        }
      ]
    },
    {
      "id": "insert",
      "title": {
        "tr": "Grafa ekleme: M komşuya bağlan",
        "en": "Insert into the graph: link M neighbours"
      },
      "narration": {
        "tr": "Vektöre rastgele bir en üst katman seçilir; bu örnekte yalnızca en alt katmana girer. Orada kendisine en yakın M düğüm bulunur ve kenarlarla bağlanır. HNSW yeni eklemeyi yeniden kurulum gerekmeden destekler.",
        "en": "A random top layer is drawn for the vector; here it only enters the bottom layer. There its M closest nodes are found and linked with edges. HNSW supports inserts without rebuilding the index."
      },
      "durationMs": 3400,
      "highlight": {
        "nodes": [
          "c0",
          "b0",
          "d0"
        ],
        "edges": [
          "e-emb-c0",
          "e-b0-c0",
          "e-c0-d0"
        ]
      },
      "nodeStates": {
        "emb": {
          "status": "idle"
        },
        "c0": {
          "status": "success",
          "badge": "yeni"
        },
        "doc": {
          "status": "idle"
        }
      },
      "edgeStates": {
        "e-emb-c0": {
          "status": "active"
        },
        "e-b0-c0": {
          "status": "active"
        },
        "e-c0-d0": {
          "status": "active"
        }
      },
      "packets": [
        {
          "edge": "e-emb-c0",
          "shape": "square",
          "label": "vektör",
          "durationMs": 1200
        }
      ],
      "annotations": [
        {
          "id": "a-m",
          "x": 610,
          "y": 570,
          "text": {
            "tr": "M en yakın komşuya kenar",
            "en": "edges to the M closest"
          },
          "tone": "info",
          "target": "c0"
        }
      ]
    },
    {
      "id": "embed-query",
      "title": {
        "tr": "Sorgu da gömülür",
        "en": "The query is embedded too"
      },
      "narration": {
        "tr": "Kullanıcı sorusu aynı gömme modelinden geçer. Artık soru \"bu vektöre en yakın k vektör hangileri?\" sorusuna dönüşmüştür.",
        "en": "The user question goes through the same embedding model. The question has become \"which k vectors are closest to this one?\""
      },
      "durationMs": 2800,
      "highlight": {
        "nodes": [
          "query",
          "emb"
        ],
        "edges": [
          "e-q-emb"
        ]
      },
      "nodeStates": {
        "query": {
          "status": "active"
        },
        "emb": {
          "status": "busy",
          "badge": "q"
        },
        "c0": {
          "status": "idle"
        }
      },
      "edgeStates": {
        "e-emb-c0": {
          "status": "muted"
        },
        "e-b0-c0": {
          "status": "idle"
        },
        "e-c0-d0": {
          "status": "idle"
        }
      },
      "packets": [
        {
          "edge": "e-q-emb",
          "shape": "envelope",
          "label": "\"Kargom nerede?\"",
          "durationMs": 1100
        }
      ]
    },
    {
      "id": "top-layer",
      "title": {
        "tr": "Üst katman: uzun atlamalar",
        "en": "Top layer: long jumps"
      },
      "narration": {
        "tr": "Arama en üst katmandaki sabit giriş noktasından başlar. Seyrek katmanda kenarlar uzundur; açgözlü adım, sorguya daha yakın olan komşuya geçer. Daha yakın komşu kalmayınca bir alt katmana inilir.",
        "en": "Search starts from the fixed entry point in the top layer. In the sparse layer edges are long; a greedy step moves to the neighbour closer to the query. When no closer neighbour remains it descends one layer."
      },
      "durationMs": 3200,
      "highlight": {
        "nodes": [
          "a2",
          "b2"
        ],
        "edges": [
          "e-emb-a2",
          "e-a2-b2"
        ]
      },
      "nodeStates": {
        "emb": {
          "status": "idle"
        },
        "a2": {
          "status": "active",
          "badge": "giriş"
        },
        "b2": {
          "status": "active",
          "badge": "daha yakın"
        }
      },
      "edgeStates": {
        "e-emb-a2": {
          "status": "active"
        }
      },
      "packets": [
        {
          "edge": "e-emb-a2",
          "shape": "dot",
          "label": "q",
          "durationMs": 900
        },
        {
          "edge": "e-a2-b2",
          "shape": "dot",
          "label": "q",
          "startAt": 1100,
          "durationMs": 1000
        }
      ],
      "annotations": [
        {
          "id": "a-highway",
          "x": 540,
          "y": 30,
          "text": {
            "tr": "otoyol: doğru semte",
            "en": "highway: to the right district"
          },
          "tone": "info",
          "target": "b2"
        }
      ]
    },
    {
      "id": "mid-layer",
      "title": {
        "tr": "Orta katman: yaklaş",
        "en": "Middle layer: get closer"
      },
      "narration": {
        "tr": "L1'e inilir ve aynı açgözlü kural daha kısa kenarlarla tekrarlanır: c'den sorguya daha yakın olan b'ye geçilir. Her katman aramayı daha dar bir bölgeye taşır.",
        "en": "The search drops to L1 and the same greedy rule repeats with shorter edges: from c it moves to b, which is closer to the query. Each layer narrows the search to a smaller region."
      },
      "durationMs": 3200,
      "highlight": {
        "nodes": [
          "c1",
          "b1"
        ],
        "edges": [
          "e-b2-c1",
          "e-b1-c1"
        ]
      },
      "nodeStates": {
        "a2": {
          "status": "idle"
        },
        "b2": {
          "status": "idle"
        },
        "c1": {
          "status": "active"
        },
        "b1": {
          "status": "active",
          "badge": "daha yakın"
        }
      },
      "edgeStates": {
        "e-b2-c1": {
          "status": "active"
        }
      },
      "packets": [
        {
          "edge": "e-b2-c1",
          "shape": "dot",
          "label": "iner",
          "durationMs": 900
        },
        {
          "edge": "e-b1-c1",
          "direction": "backward",
          "shape": "dot",
          "label": "q",
          "startAt": 1100,
          "durationMs": 1000
        }
      ]
    },
    {
      "id": "bottom-layer",
      "title": {
        "tr": "Alt katman: aday listesini genişlet",
        "en": "Bottom layer: widen the candidates"
      },
      "narration": {
        "tr": "L0 tüm vektörleri içerir. Burada tek bir komşu yerine ef_search kadar adaylık bir liste tutulur ve komşuların komşuları da denetlenir. ef_search büyüdükçe recall artar, gecikme de artar.",
        "en": "L0 contains every vector. Here instead of a single neighbour a candidate list of size ef_search is kept and neighbours of neighbours are checked too. A larger ef_search raises recall and latency together."
      },
      "durationMs": 3800,
      "highlight": {
        "nodes": [
          "b0",
          "a0",
          "c0"
        ],
        "edges": [
          "e-b1-b0",
          "e-a0-b0",
          "e-b0-c0"
        ]
      },
      "nodeStates": {
        "c1": {
          "status": "idle"
        },
        "b1": {
          "status": "idle"
        },
        "b0": {
          "status": "active",
          "badge": "aday"
        },
        "a0": {
          "status": "active",
          "badge": "aday"
        },
        "c0": {
          "status": "active",
          "badge": "aday"
        }
      },
      "edgeStates": {
        "e-b1-b0": {
          "status": "active"
        }
      },
      "packets": [
        {
          "edge": "e-b1-b0",
          "shape": "dot",
          "label": "iner",
          "durationMs": 900
        },
        {
          "edge": "e-a0-b0",
          "direction": "backward",
          "shape": "dot",
          "label": "q",
          "startAt": 1100,
          "durationMs": 900
        },
        {
          "edge": "e-b0-c0",
          "shape": "dot",
          "label": "q",
          "startAt": 1100,
          "durationMs": 900
        }
      ],
      "annotations": [
        {
          "id": "a-ef",
          "x": 470,
          "y": 580,
          "text": "ef_search",
          "tone": "info",
          "target": "b0"
        }
      ]
    },
    {
      "id": "results",
      "title": {
        "tr": "En yakın k komşu",
        "en": "The k nearest neighbours"
      },
      "narration": {
        "tr": "Aday listesindeki en yüksek skorlu k vektör sonuç olarak döner; az önce eklenen parça da aralarındadır. Sonuç yaklaşıktır: gerçek en yakın komşulardan biri kaçırılabilir; bu kayıp recall@k ile ölçülür.",
        "en": "The k highest-scoring vectors from the candidate list are returned; the chunk inserted a moment ago is among them. The result is approximate: one of the true nearest neighbours may be missed, a loss measured by recall@k."
      },
      "durationMs": 3200,
      "highlight": {
        "nodes": [
          "res",
          "b0",
          "c0"
        ],
        "edges": [
          "e-b0-res"
        ]
      },
      "nodeStates": {
        "res": {
          "status": "success",
          "badge": "k=3"
        },
        "c0": {
          "status": "success",
          "badge": "0,91"
        },
        "b0": {
          "status": "success",
          "badge": "0,88"
        },
        "a0": {
          "status": "success",
          "badge": "0,84"
        }
      },
      "edgeStates": {
        "e-b0-res": {
          "status": "active"
        }
      },
      "packets": [
        {
          "edge": "e-b0-res",
          "shape": "square",
          "label": "top-k",
          "color": "success",
          "durationMs": 1200
        }
      ],
      "annotations": [
        {
          "id": "a-recall",
          "x": 900,
          "y": 480,
          "text": {
            "tr": "yaklaşık: recall@k < 1 olabilir",
            "en": "approximate: recall@k may be < 1"
          },
          "tone": "warning",
          "target": "res"
        }
      ]
    },
    {
      "id": "vs-flat",
      "title": {
        "tr": "Kaba kuvvete göre fark",
        "en": "Compared to brute force"
      },
      "narration": {
        "tr": "Düz arama sorguyu dizindeki her vektörle karşılaştırırdı. HNSW yalnızca birkaç düğüm ziyaret etti; soluk düğümlere hiç bakılmadı. Milyonlarca vektörde bu fark, milisaniye ile saniye arasındaki farktır.",
        "en": "A flat search would compare the query with every vector in the index. HNSW visited only a handful of nodes; the faded ones were never touched. With millions of vectors this is the difference between milliseconds and seconds."
      },
      "durationMs": 3000,
      "highlight": {
        "nodes": [
          "res"
        ],
        "edges": []
      },
      "nodeStates": {
        "a1": {
          "status": "muted"
        },
        "d0": {
          "status": "muted"
        },
        "a2": {
          "status": "muted"
        }
      },
      "annotations": [
        {
          "id": "a-visited",
          "x": 560,
          "y": 200,
          "text": {
            "tr": "ziyaret edilmeyen düğümler soluk",
            "en": "unvisited nodes faded"
          },
          "tone": "info"
        }
      ]
    }
  ],
  "loop": false,
