          },
          "tone": "info"
        },
        {
          "id": "g4",
          "x": 700,
          "y": 540,
          "text": {
            "tr": "pahalı kurulum, kopyala → Prototype",
            "en": "expensive setup, copy → Prototype"
          },
          "tone": "info"
        },
        {
          "id": "g5",
          "x": 480,
          "y": 300,
          "text": {
            "tr": "tek paylaşılan kaynak → Singleton (DI ile)",
            "en": "single shared resource → Singleton (via DI)"
          },
          "tone": "warning"
        }
      ]
    }
  ],
