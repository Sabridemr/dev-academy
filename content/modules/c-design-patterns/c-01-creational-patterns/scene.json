  "steps": [
    {
      "id": "direct",
      "title": {
        "tr": "1. Doğrudan new: sıkı bağlaşıklık",
        "en": "1. Direct new: tight coupling"
      },
      "narration": {
        "tr": "OrderService içinde new EmailNotification(smtp) yazılmıştır. İstemci somut sınıfı, kurucusunun parametrelerini ve SMTP ayrıntılarını bilir. Çalışır, ama her üretim kararı istemciye gömülüdür.",
        "en": "OrderService contains new EmailNotification(smtp). The client knows the concrete class, its constructor parameters and SMTP details. It works, but every creation decision is baked into the client."
      },
      "durationMs": 4000,
      "inherit": false,
      "highlight": {
        "nodes": [
          "client",
          "email"
        ],
        "edges": [
          "cl-email"
        ]
