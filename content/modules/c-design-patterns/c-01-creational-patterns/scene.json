          "id": "g1",
          "x": 300,
          "y": 60,
          "text": {
            "tr": "alt sınıf karar verir → Factory Method",
            "en": "subclass decides → Factory Method"
          },
          "tone": "info"
        },
        {
          "id": "g2",
          "x": 700,
          "y": 60,
          "text": {
            "tr": "tutarlı ürün ailesi → Abstract Factory",
            "en": "consistent product family → Abstract Factory"
          },
          "tone": "info"
        },
        {
          "id": "g3",
          "x": 300,
          "y": 540,
          "text": {
            "tr": "çok parametre, adım adım → Builder",
