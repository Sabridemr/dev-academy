          "id": "a1",
          "x": 450,
          "y": 170,
          "text": {
            "tr": "konu somut gözlemcileri bilmez",
            "en": "the subject knows no concrete observer"
          },
          "target": "subject"
        }
      ]
    },
    {
      "id": "publish",
      "title": {
        "tr": "2. Olay yayınlanır",
        "en": "2. The event is published"
      },
      "narration": {
        "tr": "Ödeme alınınca OrderService notify(OrderPaid) çağırır. Konu listesini dolaşıp her gözlemcinin update(evt) metodunu çağırır. OrderService e-posta ya da analitik kodundan habersizdir.",
        "en": "When payment succeeds OrderService calls notify(OrderPaid). The subject iterates its list and calls update(evt) on each observer. OrderService knows nothing about email or analytics code."
      },
      "durationMs": 4000,
      "highlight": {
        "nodes": [
          "svc",
          "email",
          "analytics"
        ],
        "edges": [
          "svc-sub",
          "sub-email",
          "sub-an"
        ]
      },
      "nodeStates": {
