{
  "$schema": "../../../../packages/shared/schema/animation-scene.schema.json",
  "schemaVersion": 1,
  "id": "c-03-observer",
  "title": {
    "tr": "Observer: Yayınla, Kimin Dinlediğini Bilme",
    "en": "Observer: Publish Without Knowing Who Listens"
  },
  "summary": {
    "tr": "Gözlemciler OrderEvents konusuna abone olur; OrderPaid olayı tüm abonelere iletilir; yeni bir abone konuya dokunmadan eklenir; abonelik iptali sızıntıyı önler.",
    "en": "Observers subscribe to the OrderEvents subject; the OrderPaid event is delivered to all subscribers; a new subscriber is added without touching the subject; unsubscribing prevents leaks."
  },
  "a11y": {
    "description": {
      "tr": "Solda OrderService, ortada OrderEvents konusu, sağda EmailObserver, AnalyticsObserver ve sonradan eklenen LoyaltyObserver. Gözlemciler abone olur; OrderService notify çağırır; konu her gözlemcinin update metodunu çağırır; yeni gözlemci eklenir ve sonraki olayda o da bildirim alır; son adımda bir gözlemci aboneliğini iptal eder.",
      "en": "OrderService on the left, the OrderEvents subject in the middle, EmailObserver, AnalyticsObserver and a later-added LoyaltyObserver on the right. Observers subscribe; OrderService calls notify; the subject calls update on each observer; a new observer is added and receives the next event; in the last step one observer unsubscribes."
    }
  },
  "canvas": {
    "width": 1000,
    "height": 600
  },
  "nodes": [
