          "id": "a3",
          "x": 840,
          "y": 560,
          "text": {
            "tr": "yayıncı değişmedi: Open/Closed",
            "en": "publisher unchanged: Open/Closed"
          },
          "tone": "success",
          "target": "loyalty"
