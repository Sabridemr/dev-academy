    },
    {
      "id": "unsubscribe",
      "title": {
        "tr": "4. Abonelik iptali ve tuzaklar",
        "en": "4. Unsubscribe and pitfalls"
      },
      "narration": {
        "tr": "AnalyticsObserver kapatılırken aboneliğini iptal eder; aksi hâlde konu ona referans tutar ve bellek sızar. Diğer tuzaklar: bir gözlemcinin istisnası diğerlerini engellememeli (try/catch), sıraya güvenilmemeli, senkron ağır iş yapılmamalı (kuyruğa at).",
        "en": "AnalyticsObserver unsubscribes on shutdown; otherwise the subject keeps a reference and memory leaks. Other pitfalls: one observer's exception must not block the others (try/catch), never rely on order, no heavy synchronous work (enqueue instead)."
      },
      "durationMs": 3500,
      "highlight": {
        "nodes": [
          "analytics",
          "subject"
        ],
        "edges": [
          "an-sub"
        ]
