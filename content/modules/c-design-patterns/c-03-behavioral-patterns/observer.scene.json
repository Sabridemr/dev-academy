          "badge": "track"
        }
      },
      "edgeStates": {},
      "packets": [
        {
          "edge": "svc-sub",
          "shape": "envelope",
          "label": "OrderPaid #42",
          "durationMs": 900
        },
        {
          "edge": "sub-email",
          "startAt": 1000,
