    },
    {
      "id": "extend",
      "title": {
        "tr": "3. Yeni gözlemci, konuya dokunmadan",
        "en": "3. New observer, subject untouched"
      },
      "narration": {
        "tr": "Sadakat puanı ekibi LoyaltyObserver yazar ve abone olur. OrderEvents ve OrderService değişmez. Sonraki OrderPaid üç gözlemciye gider. Open/Closed ilkesinin en saf örneği.",
        "en": "The loyalty team writes LoyaltyObserver and subscribes. OrderEvents and OrderService do not change. The next OrderPaid reaches three observers. The purest example of the Open/Closed principle."
      },
      "durationMs": 4500,
      "highlight": {
