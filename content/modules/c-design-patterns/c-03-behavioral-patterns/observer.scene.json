  "steps": [
    {
      "id": "subscribe",
      "title": {
        "tr": "1. Abonelik",
        "en": "1. Subscription"
      },
      "narration": {
        "tr": "Açılışta EmailObserver ve AnalyticsObserver konuya abone olur. Konu yalnızca OrderObserver arayüzünü bilir; somut sınıfları tanımaz. Her subscribe() bir iptal fonksiyonu döner.",
        "en": "At startup EmailObserver and AnalyticsObserver subscribe to the subject. The subject knows only the OrderObserver interface, not the concrete classes. Each subscribe() returns an unsubscribe function."
      },
      "durationMs": 3500,
      "inherit": false,
      "highlight": {
        "nodes": [
          "subject",
          "email",
          "analytics"
        ],
        "edges": [
          "email-sub",
          "an-sub"
        ]
      },
      "nodeStates": {
        "subject": {
          "status": "active",
          "sublabel": {
            "tr": "observers: [email, analytics]",
            "en": "observers: [email, analytics]"
          }
        },
        "loyalty": {
          "visible": false
        }
      },
      "edgeStates": {
        "sub-loy": {
          "visible": false
        },
        "loy-sub": {
          "visible": false
        }
      },
      "packets": [
        {
          "edge": "email-sub",
          "shape": "diamond",
          "durationMs": 900
        },
        {
          "edge": "an-sub",
          "startAt": 300,
          "shape": "diamond",
          "durationMs": 900
        }
      ],
      "annotations": [
