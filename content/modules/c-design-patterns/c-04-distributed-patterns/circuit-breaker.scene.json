          }
        },
        "svc": {
          "status": "success",
          "sublabel": {
            "tr": "sağlıklı",
            "en": "healthy"
          }
        }
      },
      "edgeStates": {},
      "packets": [
        {
          "edge": "c-cb",
          "shape": "envelope",
