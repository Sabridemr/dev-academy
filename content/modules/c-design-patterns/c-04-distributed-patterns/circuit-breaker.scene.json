{
  "$schema": "../../../../packages/shared/schema/animation-scene.schema.json",
  "schemaVersion": 1,
  "id": "c-04-circuit-breaker",
  "title": {
    "tr": "Circuit Breaker: Kapalı → Açık → Yarı Açık",
    "en": "Circuit Breaker: Closed → Open → Half-Open"
  },
  "summary": {
    "tr": "Çağrılar breaker üzerinden geçer; ardışık hatalar eşiği aşınca breaker açılır ve istekleri ağa çıkmadan reddeder; süre dolunca tek bir deneme yapar; başarılıysa kapanır.",
    "en": "Calls pass through the breaker; when consecutive failures exceed the threshold the breaker opens and rejects requests without touching the network; after the timeout it makes one trial call; on success it closes."
  },
  "a11y": {
    "description": {
      "tr": "Solda OrderService, ortada CircuitBreaker, sağda PaymentService. Başta breaker kapalıdır ve çağrılar geçer. PaymentService hata vermeye başlar; beş hatadan sonra breaker açılır ve çağrıları anında reddeder. 30 saniye sonra yarı açık duruma geçer ve bir deneme çağrısı gönderir; başarılı olunca kapanır.",
      "en": "OrderService on the left, CircuitBreaker in the middle, PaymentService on the right. Initially the breaker is closed and calls pass. PaymentService starts failing; after five failures the breaker opens and rejects calls instantly. After 30 seconds it moves to half-open and sends one trial call; on success it closes."
    }
  },
  "canvas": {
    "width": 1000,
    "height": 600
  },
  "nodes": [
    {
      "id": "client",
      "kind": "generic",
      "label": "OrderService",
      "x": 110,
      "y": 300,
      "w": 160,
      "h": 70,
      "sublabel": {
        "tr": "charge()",
        "en": "charge()"
      }
    },
