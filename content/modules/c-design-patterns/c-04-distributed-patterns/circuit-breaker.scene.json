      "w": 220,
      "h": 90,
      "sublabel": {
        "tr": "CLOSED · failures: 0/5",
        "en": "CLOSED · failures: 0/5"
      }
    },
    {
      "id": "svc",
      "kind": "generic",
      "label": "PaymentService",
      "x": 850,
      "y": 300,
      "w": 180,
      "h": 70,
      "sublabel": {
        "tr": "sağlıklı",
        "en": "healthy"
      }
    },
    {
      "id": "fallback",
      "kind": "generic",
      "label": "Fallback",
      "x": 480,
      "y": 520,
      "w": 240,
      "h": 56,
      "sublabel": {
        "tr": "kuyruğa al / 503 + Retry-After",
        "en": "enqueue / 503 + Retry-After"
      }
    }
  ],
  "edges": [
    {
      "id": "c-cb",
      "from": "client",
      "to": "cb",
