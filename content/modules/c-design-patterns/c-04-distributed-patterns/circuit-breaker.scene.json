          "id": "a5",
          "x": 480,
          "y": 160,
          "text": {
            "tr": "metrik yayınla: durum geçişleri alarm kaynağıdır",
            "en": "publish metrics: state transitions are alert sources"
          },
          "tone": "info",
          "target": "cb"
        }
      ]
    }
  ],
