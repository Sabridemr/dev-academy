          "x": 450,
          "y": 440,
          "text": {
            "tr": "2 rapor × 3 format = 6 sınıf değil, 2 + 3 = 5",
            "en": "not 2 reports × 3 formats = 6 classes, but 2 + 3 = 5"
          },
          "tone": "success",
          "target": "report"
        }
      ]
    }
  ],
