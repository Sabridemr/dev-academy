      "annotations": []
    },
    {
      "id": "leaves",
      "title": {
        "tr": "3. Yapraklar değer döner, toplamlar yukarı akar",
        "en": "3. Leaves return values, totals flow up"
      },
      "narration": {
        "tr": "a.ts 8 KB, b.ts 12 KB döner; src 20 KB olur. README 3 KB döner; kök 23 KB döner. Yeni bir düğüm türü (SymbolicLink) eklemek istemciyi değiştirmez.",
        "en": "a.ts returns 8 KB, b.ts 12 KB; src becomes 20 KB. README returns 3 KB; root returns 23 KB. Adding a new node type (SymbolicLink) does not change the client."
      },
      "durationMs": 4500,
      "highlight": {
