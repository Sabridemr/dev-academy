{
  "$schema": "../../../../packages/shared/schema/animation-scene.schema.json",
  "schemaVersion": 1,
  "id": "c-02-composite",
  "title": {
    "tr": "Composite: Ağaçta Tek Tip Çağrı",
    "en": "Composite: One Uniform Call over a Tree"
  },
  "summary": {
    "tr": "İstemci kök dizine size() der; dizin çocuklarına aynı çağrıyı yapar; dosyalar baytlarını döner; toplamlar yukarı akar.",
    "en": "The client calls size() on the root directory; the directory makes the same call on its children; files return their bytes; totals flow upward."
  },
  "a11y": {
    "description": {
      "tr": "Solda DiskUsageReport istemcisi, ortada kök dizin, sağında src dizini ve altında üç dosya. İstemci kök üzerinde size çağırır; kök src dizinine ve README dosyasına aynı çağrıyı yapar; src içindeki iki dosya boyutlarını döner; src toplar; kök toplar ve 23 KB döner.",
      "en": "DiskUsageReport client on the left, the root directory in the middle, the src directory to its right and three files below. The client calls size on root; root makes the same call on the src directory and the README file; the two files inside src return their sizes; src sums; root sums and returns 23 KB."
    }
  },
  "canvas": {
    "width": 1000,
    "height": 600
  },
  "nodes": [
    {
      "id": "client",
      "kind": "generic",
      "label": "DiskUsageReport",
      "x": 110,
      "y": 300,
      "w": 170,
      "h": 70,
      "sublabel": {
        "tr": "FsNode bekler",
        "en": "expects FsNode"
      }
    },
    {
      "id": "root",
      "kind": "generic",
      "label": "/ (Directory)",
      "x": 400,
      "y": 300,
      "w": 190,
      "h": 70,
      "sublabel": {
        "tr": "children: [src, README]",
        "en": "children: [src, README]"
      }
    },
    {
      "id": "src",
      "kind": "generic",
      "label": "src (Directory)",
      "x": 700,
      "y": 160,
      "w": 190,
      "h": 70,
      "sublabel": {
        "tr": "children: [a.ts, b.ts]",
        "en": "children: [a.ts, b.ts]"
