    {
      "id": "decorator",
      "title": {
        "tr": "2. Decorator: davranış ekle",
        "en": "2. Decorator: add behavior"
      },
      "narration": {
        "tr": "Arayüz aynı; sarmalayıcı çağrıyı iletmeden önce/sonra bir şey yapar: loglar, yeniden dener, önbellekler, ölçer. Zincirlenebilir ve çalışma zamanında seçilir. Amaç: GENİŞLETME.",
        "en": "Same interface; the wrapper does something before/after forwarding: logs, retries, caches, measures. It chains and is chosen at runtime. Goal: EXTENSION."
      },
      "durationMs": 3500,
      "highlight": {
        "nodes": [
          "wrap"
        ],
        "edges": [
          "c-w",
          "w-s"
        ]
      },
      "nodeStates": {
        "wrap": {
          "label": "Decorator",
          "sublabel": {
            "tr": "send() → log + retry → send()",
            "en": "send() → log + retry → send()"
          }
        }
      },
      "edgeStates": {
        "c-w": {
          "label": "send(msg)"
        },
        "w-s": {
          "label": "send(msg)"
        }
      },
      "packets": [
        {
          "edge": "c-w",
          "shape": "envelope",
          "label": "send()",
          "durationMs": 900
        },
        {
          "edge": "w-s",
          "startAt": 1000,
          "shape": "envelope",
          "label": "send()",
          "durationMs": 700
        },
        {
