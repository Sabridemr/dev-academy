          "startAt": 1000,
          "direction": "backward",
          "color": "danger",
          "label": "403",
          "durationMs": 800
        }
      ],
      "annotations": [
        {
          "id": "a3",
          "x": 420,
          "y": 160,
          "text": {
            "tr": "gerçek nesnenin yaşam döngüsü ve erişimi proxy'de",
            "en": "lifecycle and access of the real object live in the proxy"
          },
          "target": "wrap"
        }
      ]
    },
    {
      "id": "facade",
      "title": {
        "tr": "4. Facade: çok kapıyı tek kapıya indir",
        "en": "4. Facade: reduce many doors to one"
      },
      "narration": {
        "tr": "Artık arkada üç alt sistem var ve istemci hepsini doğru sırayla çağırmak zorunda. Facade basit bir metot sunar ve koordinasyonu üstlenir. Amaç: BASİTLEŞTİRME. Alt sistemler hâlâ doğrudan erişilebilir.",
        "en": "Now there are three subsystems behind and the client would have to call all of them in the right order. The facade offers one simple method and takes over coordination. Goal: SIMPLIFICATION. The subsystems remain directly accessible."
      },
      "durationMs": 4500,
