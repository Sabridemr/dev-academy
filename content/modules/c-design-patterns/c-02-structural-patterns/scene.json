          "durationMs": 600
        },
        {
          "edge": "w-s",
          "startAt": 2500,
          "shape": "envelope",
          "label": "send() (retry)",
          "durationMs": 700
        }
      ],
      "annotations": [
        {
          "id": "a2",
          "x": 420,
          "y": 160,
          "text": {
            "tr": "aynı arayüz + eklenen davranış, zincirlenebilir",
            "en": "same interface + added behavior, chainable"
          },
          "target": "wrap"
        }
      ]
    },
    {
      "id": "proxy",
      "title": {
        "tr": "3. Proxy: erişimi kontrol et",
        "en": "3. Proxy: control access"
      },
      "narration": {
        "tr": "Arayüz yine aynı; ama sarmalayıcı gerçek nesnenin yerine geçer ve ona ERİŞİMİ yönetir: tembel oluşturma, yetki, önbellek, uzak çağrı. Çağrıyı iletmeyebilir bile. Amaç: KONTROL.",
        "en": "Same interface again; but the wrapper stands in for the real object and manages ACCESS to it: lazy creation, authorization, cache, remote call. It may not even forward. Goal: CONTROL."
      },
      "durationMs": 3500,
      "highlight": {
        "nodes": [
          "wrap"
        ],
        "edges": [
          "c-w"
        ]
      },
      "nodeStates": {
        "wrap": {
          "label": "Proxy",
          "sublabel": {
            "tr": "yetki yok → 403, cache hit → iletme",
            "en": "no permission → 403, cache hit → no forward"
          }
        },
        "svc": {
          "status": "muted"
        }
      },
      "edgeStates": {
        "w-s": {
          "status": "muted",
          "label": ""
        },
