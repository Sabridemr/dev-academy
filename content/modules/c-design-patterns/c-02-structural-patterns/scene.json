  "steps": [
    {
      "id": "adapter",
      "title": {
        "tr": "1. Adapter: arayüz uymuyor",
        "en": "1. Adapter: the interface does not fit"
      },
      "narration": {
        "tr": "İstemci charge(amountMinor) bekler, servis makePayment(lira) sunar. Sarmalayıcı istemcinin arayüzünü uygular ve çağrıyı servise çevirir. Amaç: UYUM. İmzalar farklıdır.",
        "en": "The client expects charge(amountMinor), the service offers makePayment(lira). The wrapper implements the client's interface and translates the call. Goal: COMPATIBILITY. The signatures differ."
      },
      "durationMs": 3500,
      "inherit": false,
      "highlight": {
        "nodes": [
          "wrap"
        ],
        "edges": [
          "c-w",
          "w-s"
        ]
      },
