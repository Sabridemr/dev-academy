            "tr": "Composite: yaprak = dal, ağaç üzerinde tek tip çağrı",
            "en": "Composite: leaf = branch, one uniform call over a tree"
          },
          "tone": "info"
        },
        {
          "id": "g2",
          "x": 700,
          "y": 80,
          "text": {
