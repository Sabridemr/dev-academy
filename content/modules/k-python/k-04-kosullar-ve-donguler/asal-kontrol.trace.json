  "code": "def asal_mi(n):\n    if n < 2:\n        return False\n    for bolen in range(2, n):\n        if n % bolen == 0:\n            print(n, \"asal değil, bölen:\", bolen)\n            break\n    else:\n        print(n, \"asal\")\n        return True\n    return False\n\n\nasal_mi(7)\nasal_mi(9)",
