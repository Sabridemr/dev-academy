  "code": "import functools\n\n\ndef logla(fonk):\n    @functools.wraps(fonk)\n    def sarmalayici(*args, **kwargs):\n        print(\"->\", fonk.__name__, args)\n        sonuc = fonk(*args, **kwargs)\n        print(\"<-\", sonuc)\n        return sonuc\n\n    return sarmalayici\n\n\n@logla\ndef topla(a, b):\n    return a + b\n\n\nx = topla(2, 3)\nprint(topla.__name__, x)",
