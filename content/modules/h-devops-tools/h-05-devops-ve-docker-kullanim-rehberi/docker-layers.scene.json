    {
      "id": "push",
      "title": {
        "tr": "push: yalnızca yeni katmanlar gider",
        "en": "push: only new layers travel"
      },
      "narration": {
        "tr": "docker push imajı registry'ye gönderir. Registry'de zaten bulunan katmanlar için \"Layer already exists\" yazar ve onları yeniden yüklemez. Ağdan yalnızca değişen iki katman geçer.",
        "en": "docker push sends the image to the registry. For layers the registry already has it prints \"Layer already exists\" and does not upload them again. Only the two changed layers cross the network."
      },
      "durationMs": 4000,
