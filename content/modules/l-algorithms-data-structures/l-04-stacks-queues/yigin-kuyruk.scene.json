            "tr": "çerçeve",
            "en": "frame"
          },
          "status": "active",
          "badge": "tepe/top"
        }
      },
      "packets": [
        {
          "edge": "call1",
          "label": "hesapla(3)",
          "shape": "square",
          "durationMs": 900
        }
      ]
    },
    {
      "id": "kare",
      "title": {
        "tr": "push: kare(3)",
        "en": "push: kare(3)"
      },
      "narration": {
        "tr": "`hesapla` da `kare(3)`'ü çağırır. Yığında üç çerçeve var ve yalnızca en üstteki çalışıyor; alttakiler sırasını bekliyor.",
        "en": "`hesapla` in turn calls `kare(3)`. Three frames are on the stack and only the top one runs; the ones below wait their turn."
      },
      "durationMs": 2800,
      "highlight": {
        "nodes": [
          "st2"
        ],
        "edges": []
      },
      "nodeStates": {
        "st1": {
          "status": "busy",
          "badge": ""
        },
        "st2": {
          "label": "kare(3)",
          "sublabel": {
            "tr": "çerçeve",
            "en": "frame"
          },
          "status": "active",
          "badge": "tepe/top"
        }
      },
      "packets": [
        {
          "edge": "call2",
          "label": "kare(3)",
          "shape": "square",
          "durationMs": 900
        }
      ]
    },
    {
      "id": "pop1",
      "title": {
        "tr": "pop: kare 9 döndürür",
        "en": "pop: kare returns 9"
      },
      "narration": {
        "tr": "`kare(3)` biter ve 9 döndürür. **En son giren çerçeve ilk çıkar**: tepe silinir ve kontrol hemen altındaki `hesapla`'ya geri döner.",
        "en": "`kare(3)` finishes and returns 9. **The last frame in is the first out**: the top is popped and control returns to `hesapla` right below it."
      },
      "durationMs": 3000,
      "highlight": {
        "nodes": [
          "st1",
          "st2"
        ],
        "edges": []
      },
      "nodeStates": {
        "st2": {
          "label": "—",
          "sublabel": {
            "tr": "boş",
            "en": "empty"
          },
          "status": "muted",
          "badge": ""
        },
        "st1": {
          "status": "active",
          "badge": "tepe/top"
        }
      },
      "packets": [
        {
          "edge": "call2",
          "direction": "backward",
          "label": "return 9",
          "durationMs": 900
        }
      ]
    },
    {
      "id": "pop2",
      "title": {
        "tr": "pop: hesapla 10 döndürür",
        "en": "pop: hesapla returns 10"
      },
      "narration": {
        "tr": "`hesapla` kaldığı yerden devam eder, 9 + 1 = 10 döndürür ve onun çerçevesi de çıkarılır. Çağrılar geldikleri sıranın **tersine** biter: LIFO.",
        "en": "`hesapla` resumes where it left off, returns 9 + 1 = 10 and its frame is popped too. Calls finish in the **reverse** order of arrival: LIFO."
      },
      "durationMs": 3000,
      "highlight": {
        "nodes": [
          "st0",
          "st1"
        ],
        "edges": []
      },
      "nodeStates": {
        "st1": {
