        }
      ]
    },
    {
      "id": "hesapla",
      "title": {
        "tr": "push: hesapla(3)",
        "en": "push: hesapla(3)"
      },
      "narration": {
        "tr": "`main()` içinden `hesapla(3)` çağrılır. `main` yarıda kalır ve bekler; yeni çerçeve onun **üstüne** konur.",
        "en": "`main()` calls `hesapla(3)`. `main` is paused and waits; the new frame is pushed **on top** of it."
      },
      "durationMs": 2800,
      "highlight": {
        "nodes": [
