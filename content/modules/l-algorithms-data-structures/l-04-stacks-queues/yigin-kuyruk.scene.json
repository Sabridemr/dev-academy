    {
      "id": "enq2",
      "title": {
        "tr": "enqueue: yeni iş sona",
        "en": "enqueue: new job at the back"
      },
      "narration": {
        "tr": "Bu sırada yeni bir fatura gelir. Önde bekleyenler varken araya giremez; kuyruğun **sonuna** eklenir. Sıradaki yazdırılacak iş foto olacaktır.",
        "en": "Meanwhile a new invoice arrives. It cannot cut in front of waiting jobs; it is added to the **back**. The next job to print will be the photo."
      },
      "durationMs": 3000,
      "highlight": {
        "nodes": [
