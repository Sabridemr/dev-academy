          "id": "a-yigin",
          "x": 340,
          "y": 160,
          "text": {
            "tr": "yığın: tek uç (tepe)",
            "en": "stack: one end (top)"
          }
        },
        {
          "id": "a-kuyruk",
          "x": 710,
          "y": 400,
          "text": {
            "tr": "kuyruk: arkadan gir, önden çık",
            "en": "queue: in at the back, out at the front"
          }
        }
      ]
    },
