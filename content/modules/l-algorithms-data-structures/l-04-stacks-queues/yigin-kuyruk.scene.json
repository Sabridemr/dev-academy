  "steps": [
    {
      "id": "intro",
      "title": {
        "tr": "İki kısıtlı yapı",
        "en": "Two restricted structures"
      },
      "narration": {
        "tr": "Solda bir **yığın**: eleman yalnızca tepeden girer ve tepeden çıkar (LIFO). Sağda bir **kuyruk**: eleman arkadan girer, önden çıkar (FIFO). Yığınla fonksiyon çağrılarını, kuyrukla yazıcı işlerini izleyeceğiz.",
        "en": "On the left a **stack**: elements enter and leave only at the top (LIFO). On the right a **queue**: elements join at the back and leave from the front (FIFO). We will follow function calls with the stack and print jobs with the queue."
      },
      "durationMs": 3200,
      "inherit": false,
      "highlight": {
        "nodes": [
          "st0",
          "st1",
          "st2",
          "st3",
          "q0",
          "q1",
          "q2",
          "q3"
        ],
        "edges": []
      },
      "annotations": [
