    {
      "id": "deq",
      "title": {
        "tr": "dequeue: önce gelen önce yazdırılır",
        "en": "dequeue: first come, first printed"
      },
      "narration": {
        "tr": "Yazıcı boşalınca kuyruğun **başındaki** işi alır: ilk gönderilen rapor. Elemanlar kaydırılmaz; yalnızca `baş` işaretçisi bir ileri gider, bu yüzden işlem O(1)'dir.",
        "en": "When the printer is free it takes the job at the **front**: the report sent first. Nothing is shifted; only the head pointer moves forward, so the operation is O(1)."
      },
      "durationMs": 3200,
      "highlight": {
        "nodes": [
          "q0",
          "printer"
        ],
        "edges": []
      },
      "nodeStates": {
