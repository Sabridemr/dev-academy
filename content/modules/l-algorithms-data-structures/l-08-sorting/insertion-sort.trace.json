  "language": "python",
  "code": "def insertion_sort(dizi):\n    for i in range(1, len(dizi)):\n        anahtar = dizi[i]\n        j = i - 1\n        while j >= 0 and dizi[j] > anahtar:\n            dizi[j + 1] = dizi[j]\n            j -= 1\n        dizi[j + 1] = anahtar\n    return dizi\n\n\nnotlar = [5, 2, 4, 1, 3]\nprint(insertion_sort(notlar))",
