  "code": "def fib(n, memo):\n    if n in memo:\n        return memo[n]\n    if n <= 1:\n        return n\n    sonuc = fib(n - 1, memo) + fib(n - 2, memo)\n    memo[n] = sonuc\n    return sonuc\n\n\nnot_defteri = {}\nprint(fib(5, not_defteri))\nprint(not_defteri)",
