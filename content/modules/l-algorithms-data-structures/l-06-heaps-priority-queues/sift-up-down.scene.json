  "steps": [
    {
      "id": "intro",
      "title": {
        "tr": "Min-heap: ağaç ve dizi",
        "en": "Min-heap: tree and array"
      },
      "narration": {
        "tr": "Altı elemanlı bir min-heap: her ebeveyn çocuklarından küçük, en küçük eleman kökte. Altta aynı heap'in bellekteki hâli var: ağaç seviyeleri dizide yan yana durur, `i` indeksli düğümün çocukları `2i+1` ve `2i+2`'dedir.",
        "en": "A six-element min-heap: every parent is smaller than its children and the smallest element sits at the root. Below is the same heap in memory: tree levels lie side by side in an array, and node `i` has children at `2i+1` and `2i+2`."
      },
      "durationMs": 3500,
      "inherit": false,
      "highlight": {
        "nodes": [
          "t0",
          "a0"
        ],
        "edges": []
      },
