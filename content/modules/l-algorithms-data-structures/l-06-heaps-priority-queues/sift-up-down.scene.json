        }
      ]
    },
    {
      "id": "down2",
      "title": {
        "tr": "4 < 8: dur",
        "en": "4 < 8: stop"
      },
      "narration": {
        "tr": "4 artık indeks 2'de; tek çocuğu indeks 5'teki 8. 4 < 8 olduğu için heap kuralı sağlandı ve sift-down durur. Dizi yine geçerli bir heap: [3, 5, 4, 9, 6, 8].",
        "en": "4 now sits at index 2; its only child is the 8 at index 5. Since 4 < 8 the heap rule holds and sift-down stops. The array is a valid heap again: [3, 5, 4, 9, 6, 8]."
      },
      "durationMs": 3000,
