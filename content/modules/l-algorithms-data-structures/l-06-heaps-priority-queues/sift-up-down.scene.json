          "x": 330,
          "y": 25,
          "text": {
            "tr": "kök = en küçük",
            "en": "root = smallest"
          },
          "target": "t0",
          "tone": "success"
        }
      ]
    },
    {
      "id": "push",
      "title": {
        "tr": "push(2): sona ekle",
        "en": "push(2): append at the end"
      },
      "narration": {
        "tr": "Yeni eleman önce dizinin **sonuna** (indeks 6) eklenir; böylece ağaç tam kalır. Ama 2, ebeveyni 4'ten küçük: heap kuralı bozuldu.",
        "en": "The new element is first appended at the **end** of the array (index 6), so the tree stays complete. But 2 is smaller than its parent 4: the heap rule is broken."
      },
      "durationMs": 3000,
      "highlight": {
        "nodes": [
          "t6",
          "a6",
          "t2"
        ],
        "edges": []
      },
      "nodeStates": {
        "t6": {
          "visible": true,
          "label": "2",
          "status": "warning"
        },
        "a6": {
          "visible": true,
          "label": "2",
          "status": "warning"
        }
