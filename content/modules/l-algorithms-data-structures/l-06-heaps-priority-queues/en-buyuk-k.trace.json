  "code": "import heapq\n\n\ndef en_buyuk_k(sayilar, k):\n    heap = []\n    for x in sayilar:\n        if len(heap) < k:\n            heapq.heappush(heap, x)\n        elif x > heap[0]:\n            heapq.heapreplace(heap, x)\n    return sorted(heap, reverse=True)\n\n\nprint(en_buyuk_k([5, 1, 9, 3, 7, 12, 4], 3))",
