  "code": "def alt_sinir(dizi, hedef):\n    sol, sag = 0, len(dizi)\n    while sol < sag:\n        orta = (sol + sag) // 2\n        if dizi[orta] < hedef:\n            sol = orta + 1\n        else:\n            sag = orta\n    return sol\n\n\nnotlar = [40, 55, 55, 55, 70, 85]\nilk = alt_sinir(notlar, 55)\nson = alt_sinir(notlar, 56)\nprint(\"ilk:\", ilk, \"adet:\", son - ilk)\nprint(\"60 eklenecek yer:\", alt_sinir(notlar, 60))",
