  "code": "def iki_toplam(sirali, hedef):\n    sol, sag = 0, len(sirali) - 1\n    while sol < sag:\n        toplam = sirali[sol] + sirali[sag]\n        if toplam == hedef:\n            return sol, sag\n        elif toplam < hedef:\n            sol += 1\n        else:\n            sag -= 1\n    return None\n\n\nprint(iki_toplam([1, 3, 4, 6, 8, 11], 10))",
