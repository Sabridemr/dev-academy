        }
      },
      "packets": [
        {
          "edge": "e_n3_n6",
          "label": "7",
          "shape": "diamond",
          "durationMs": 900
        }
      ]
    },
    {
      "id": "ins3",
      "title": {
        "tr": "6'nın sağı boş: 7 buraya",
        "en": "6 has no right child: 7 goes here"
      },
      "narration": {
        "tr": "7 > 6 ve 6'nın sağ çocuğu yok. Boş yere ulaştık: 7 yeni yaprak olarak eklenir. Toplam 3 karşılaştırma, yani ağacın yüksekliği kadar: **O(h)**.",
        "en": "7 > 6 and 6 has no right child. We reached an empty spot: 7 is added as a new leaf. Three comparisons in total, the height of the tree: **O(h)**."
      },
      "durationMs": 3000,
      "highlight": {
        "nodes": [
          "n6",
          "n7"
