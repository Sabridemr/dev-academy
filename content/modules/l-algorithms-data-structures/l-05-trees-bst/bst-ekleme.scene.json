    },
    {
      "id": "ins1",
      "title": {
        "tr": "7 ekle: 8'de sola",
        "en": "Insert 7: left at 8"
      },
      "narration": {
        "tr": "7'yi eklemek için kökten başlarız. 7 < 8 olduğu için 7 kesinlikle sol alt ağaçtadır; sağdaki 10 ve 14'e bir daha bakmayız.",
        "en": "To insert 7 we start at the root. Since 7 < 8 it must go into the left subtree; we never look at 10 and 14 again."
      },
      "durationMs": 2800,
      "highlight": {
        "nodes": [
          "n8",
          "n3"
        ],
        "edges": []
