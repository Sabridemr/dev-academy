          "label": "7",
          "shape": "diamond",
          "durationMs": 900
        }
      ]
    },
    {
      "id": "ins2",
      "title": {
        "tr": "3'te sağa",
        "en": "Right at 3"
      },
      "narration": {
        "tr": "7 > 3: sağa, 6'ya ineriz. 1 içeren sol alt ağaç da elenir. Her adımda ağacın bir dalını tamamen bırakıyoruz.",
        "en": "7 > 3: go right, down to 6. The left subtree holding 1 is ruled out too. At each step we drop a whole branch of the tree."
      },
      "durationMs": 2800,
      "highlight": {
        "nodes": [
          "n3",
          "n6"
        ],
        "edges": []
      },
      "nodeStates": {
