{
  "name": "@devacademy/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DevAcademy mobil uygulaması (iOS + Android) — Expo SDK 57, React Native 0.86",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "pnpm --filter @devacademy/shared build && expo start --lan --go",
    "start:lan:dev": "pnpm --filter @devacademy/shared build && expo start --lan --dev-client",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "expo export --platform all --output-dir dist",
    "export": "expo export --platform all",
    "detox:ios": "detox test --configuration ios.sim.debug",
    "detox:android": "detox test --configuration android.emu.debug",
    "clean": "rm -rf .expo dist coverage"
  },
  "dependencies": {
    "@devacademy/shared": "workspace:*",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.80.0",
    "expo": "~57.0.30",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.16",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "7.3.8",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.16",
    "detox": "^20.40.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
