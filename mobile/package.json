{
  "name": "@devacademy/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DevAcademy mobil uygulaması (iOS + Android) — Expo SDK 53, React Native 0.79",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "expo export --platform all --output-dir dist",
    "export": "expo export --platform all",
    "test:e2e": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "clean": "rm -rf .expo dist coverage"
  },
  "dependencies": {
    "@devacademy/shared": "workspace:*",
    "@expo/metro-runtime": "~5.0.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "7.4.6",
    "@react-navigation/core": "7.12.4",
    "@react-navigation/elements": "2.6.3",
    "@react-navigation/native": "7.1.17",
    "@react-navigation/native-stack": "7.3.25",
    "@react-navigation/routers": "7.5.1",
    "@tanstack/react-query": "^5.80.0",
    "expo": "~53.0.27",
    "expo-apple-authentication": "~7.2.4",
    "expo-auth-session": "~6.2.1",
    "expo-constants": "~17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-notifications": "~0.31.5",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "lottie-react-native": "7.2.2",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "~3.3.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "rive-react-native": "~9.8.6",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "babel-preset-expo": "~13.2.5",
    "detox": "^20.40.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native",
        "@react-navigation/bottom-tabs",
        "@react-navigation/native-stack"
      ]
    }
  }
}
