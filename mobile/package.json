{
  "name": "@devacademy/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "DevAcademy mobil uygulaması (iOS + Android) — Expo SDK 53, React Native 0.79",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "pnpm --filter @devacademy/shared build && expo start --lan",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "expo export --platform all --output-dir dist",
    "export": "expo export --platform all",
    "detox:ios": "detox test --configuration ios.sim.debug",
    "detox:android": "detox test --configuration android.emu.debug",
    "clean": "rm -rf .expo dist coverage"
  },
  "dependencies": {
    "@devacademy/shared": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@tanstack/react-query": "^5.80.0",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "lottie-react-native": "7.3.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "~3.3.3",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "detox": "^20.40.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.3"
  }
}
