# DevAcademy mobil — örnek ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# EXPO_PUBLIC_* ile başlayan değişkenler derleme anında uygulama koduna gömülür; gizli anahtar KOYMAYIN.

# Backend API kök adresi (sonunda / olmadan). Android emülatöründe localhost yerine 10.0.2.2 kullanın.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Web uygulaması adresi (mobilde desteklenmeyen simülatörler için "Web'de aç" bağlantısı)
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Google ile giriş (Google Cloud Console → OAuth istemci kimlikleri)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Expo push bildirimleri için EAS proje kimliği (eas init sonrası)
EAS_PROJECT_ID=
