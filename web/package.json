    "lucide-react": "^0.503.0",
    "next": "^15.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.3.0",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
