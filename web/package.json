{
  "name": "@devacademy/web",
  "version": "0.1.0",
  "description": "DevAcademy web uygulaması (Next.js App Router)",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
